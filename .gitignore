# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data (not redistributed; user-supplied) — ignore all files, keep .gitkeep skeletons
data/**
!data/**/
!data/**/.gitkeep

# Results — ignore all outputs, keep .gitkeep skeletons
results/**
!results/**/
!results/**/.gitkeep
# 在现有 results 规则之后追加：
!results/figures/**
!results/losses/*.csv
!results/blo/*.csv
!results/backtest/*.csv

# Data-fetch cache
data_fetch/cache/

# Environment / OS / editor
.env
.DS_Store
.idea/
.vscode/
